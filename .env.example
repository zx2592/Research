# ============================================================================
# AlphaSystem 环境变量模板
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，勿提交真实密钥）
#   cp .env.example .env
# ============================================================================

# ---- 必填 ------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key            # 默认 Provider（gemini）的 LLM Key
TAVILY_API_KEY=your-tavily-api-key            # 主力搜索引擎

# ============================================================================
# LLM Provider 选择
# ----------------------------------------------------------------------------
# LLM_PROVIDER 决定走哪家 LLM，默认 gemini。四选一：
#   gemini      Google google-genai SDK（默认，自动函数调用）
#   openai      OpenAI 官方
#   openrouter  OpenRouter 聚合
#   qwen        阿里云通义千问（DashScope 兼容模式）
# openai / openrouter / qwen 共用一套 OpenAI 兼容适配器（含工具循环），
# 需要安装 openai SDK（已在 requirements.txt）。切换后填对应的 KEY 即可。
# ============================================================================
# LLM_PROVIDER=gemini

# ---- Provider: gemini（默认）-----------------------------------------------
GEMINI_API_KEY_BACKUP=                         # 备用 Key（主 Key 失败自动回退，可留空）
# VPS_MODEL=gemini-3-flash                      # 常规模型（覆盖默认值）
# VPS_MODEL_PRO=gemini-3.1-pro                  # /deep、/value 用的 Pro 模型

# ---- Provider: openai ------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini                      # 默认 gpt-4o-mini
# OPENAI_MODEL_PRO=gpt-4o                       # 默认 gpt-4o

# ---- Provider: openrouter --------------------------------------------------
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
# OPENROUTER_MODEL=openai/gpt-4o-mini           # 默认 openai/gpt-4o-mini
# OPENROUTER_MODEL_PRO=openai/gpt-4o            # 默认 openai/gpt-4o

# ---- Provider: qwen（DashScope 兼容模式）-----------------------------------
# QWEN_API_KEY=sk-your-qwen-key                 # 或改用 DASHSCOPE_API_KEY
# DASHSCOPE_API_KEY=                            # QWEN_API_KEY 未设时回退到此
# QWEN_MODEL=qwen-plus                          # 默认 qwen-plus
# QWEN_MODEL_PRO=qwen-max                       # 默认 qwen-max

# ---- 工具循环（OpenAI 兼容 Provider 适用）---------------------------------
# TOOL_LOOP_MAX_ITERATIONS=15                   # 工具调用最大轮数（默认 15）

# ============================================================================
# 可选：通知与数据源
# ============================================================================
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token   # Telegram Bot
# TELEGRAM_CHAT_ID=your-telegram-chat-id
# BRAVE_SEARCH_API_KEY=your-brave-key           # 备用搜索
# TUSHARE_TOKEN=your-tushare-token              # A 股基本面/公告
# RSSHUB_BASE=https://your-rsshub-instance      # 自建 RSSHub 地址
# OBSIDIAN_VAULT_PAT=your-obsidian-pat          # Obsidian 同步（可选）
